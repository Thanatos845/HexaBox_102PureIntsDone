                    RowBox[{"ds", "[", 
                    RowBox[{"invariantsnodUpperCase", "[", 
                    RowBox[{"[", "var", "]"}], "]"}], "]"}]}], "]"}], ",", 
                    RowBox[{"del", "[", "___", "]"}]}], "]"}], ",", 
                   RowBox[{"Expand", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"PureIntegrals", "[", 

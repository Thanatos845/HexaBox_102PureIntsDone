                 RowBox[{
                  RowBox[{"root", "'"}], "[", "x_", "]"}], ":>", 
                 RowBox[{"1", "/", 
                  RowBox[{"(", 
                   RowBox[{"2", " ", 
                    RowBox[{"root", "[", "x", "]"}]}], ")"}]}]}]}], ")"}], "/.", 
              RowBox[{
               RowBox[{"root", "[", "x_", "]"}], ":>", 
               RowBox[{"PowerMod", "[", 
                RowBox[{"x", ",", 
                 RowBox[{"1", "/", "2"}], ",", "$P"}], "]"}]}]}], ",", 

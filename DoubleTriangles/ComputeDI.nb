                    RowBox[{"DeleteList", ",", 
                    RowBox[{"var", "+", "1"}]}], "]"}], "]"}], "]"}]}], "/.", 
                    "epsrepl"}], ",", 
                    RowBox[{"Modulus", "->", "$P"}]}], "]"}]}], "]"}], "/.", 
                 "tPoint"}], "/.", 

      RowBox[{"Delete", "[", 
       RowBox[{"MaxPD", ",", "Nulls"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Vars", "=", 
      RowBox[{"Delete", "[", 
       RowBox[{"diffInvariants", ",", "Nulls"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TermsNeeded", "=", 

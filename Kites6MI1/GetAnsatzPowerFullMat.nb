            ",", 
            RowBox[{"Modulus", "->", "$P"}]}], "]"}], ",", "10"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MaxPN", "=", 

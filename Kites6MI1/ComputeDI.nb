Cell[CellGroupData[{

Cell["Apply IBP Reduction", "Title",
 CellChangeTimes->{{3.96416211585487*^9, 
  3.964162119670632*^9}},ExpressionUUID->"0a9f691b-e9af-4dc4-bad6-\
20176c585312"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"diffIntsIBREDUCED", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"diffInts", "/.", "reductionRules"}], "/.", "ExtraRelations"}], 
     ",", 
     RowBox[{"Modulus", "->", "$P"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NonReduced", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Cases", "[", 
      RowBox[{"diffIntsIBREDUCED", ",", "_hxb", ",", "Infinity"}], "]"}], "//",
      "DeleteDuplicates"}], "//", 
    RowBox[{"EchoFunction", "[", "Length", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NullInts2", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{"NonReduced", ",", "SubLaporta"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diffIntsIBREDUCED", "=", 
   RowBox[{"diffIntsIBREDUCED", "/.", 
    RowBox[{"Thread", "[", 
     RowBox[{"Rule", "[", 
      RowBox[{"NullInts2", ",", "0"}], "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.964162189982592*^9, 3.964162218414571*^9}, {
  3.96538156706831*^9, 3.965381594986149*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"6da6708a-f1ea-4989-9946-30cece583ee4"],


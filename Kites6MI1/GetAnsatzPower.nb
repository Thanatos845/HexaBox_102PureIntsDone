Cell[BoxData[
 RowBox[{
  RowBox[{"getRecoSettings", "[", "pos_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Reco", ",", "MaxPN", ",", "MaxPD", ",", "Nulls", ",", "Vars", ",", 
      "TermsNeeded"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pos", "//", "Echo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Reco", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"powerReconstruct", "[", 
          RowBox[{"tvals", ",", 
           RowBox[{
            RowBox[{"M0Mats", "[", 
             RowBox[{"diffInvariants", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "pos"}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "10"}], "}"}]}], "]"}], "//", 
       "Echo"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MaxPN", "=", 
      RowBox[{"Exponent", "[", 
       RowBox[{
        RowBox[{"Numerator", "[", "Reco", "]"}], ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MaxPD", "=", 
      RowBox[{"Exponent", "[", 
       RowBox[{
        RowBox[{"Denominator", "[", "Reco", "]"}], ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Nulls", "=", 
      RowBox[{"Position", "[", 
       RowBox[{"MaxPD", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MaxPN", "=", 
      RowBox[{"Delete", "[", 
       RowBox[{"MaxPN", ",", "Nulls"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MaxPD", "=", 
      RowBox[{"Delete", "[", 
       RowBox[{"MaxPD", ",", "Nulls"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Vars", "=", 
      RowBox[{"Delete", "[", 
       RowBox[{"diffInvariants", ",", "Nulls"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TermsNeeded", "=", 
      RowBox[{
       RowBox[{"ansatzTermsN", "[", 
        RowBox[{
         RowBox[{"Length", "[", "Vars", "]"}], ",", 
         RowBox[{"Max", "[", "MaxPN", "]"}]}], "]"}], "+", 
       RowBox[{"ansatzTermsN", "[", 
        RowBox[{
         RowBox[{"Length", "[", "Vars", "]"}], ",", 
         RowBox[{"Max", "[", "MaxPD", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{
       "pos", ",", "Vars", ",", "MaxPN", ",", "MaxPD", ",", "TermsNeeded"}], 
       "}"}], "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   "]"}], "   "}]], "Input",

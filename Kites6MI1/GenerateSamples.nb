Cell["Generate M0 and M1 Samples", "Title",
 CellChangeTimes->{{3.968312297975882*^9, 
  3.968312307183695*^9}},ExpressionUUID->"2053e717-0ba3-427c-85a4-\
e9cc85c2ccc7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"NSamples", "=", "300"}], ";"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"$P", "=", 
     RowBox[{
      SuperscriptBox["2", "31"], "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GetConstAndLinTerm", "[", 
     RowBox[{"pos_", ",", "var_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "phasespacepointsperm", ",", "Mat1", ",", "Mat2", ",", "ep1", ",", 
        "ep2", ",", "M1Mat", ",", "M0Mat"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"phasespacepointsperm", "=", 
        RowBox[{"Permute", "[", 
         RowBox[{"phasespacepoints", ",", "perm"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Mat1", "=", 
        RowBox[{
         RowBox[{"Permute", "[", 
          RowBox[{
           RowBox[{"dhxbMatrices", "[", "var", "]"}], ",", "perm"}], "]"}], 
         "[", 
         RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Mat2", "=", 
        RowBox[{
         RowBox[{"Permute", "[", 
          RowBox[{
           RowBox[{"dhxbMatrices", "[", "var", "]"}], ",", "perm"}], "]"}], 
         "[", 
         RowBox[{"[", 
          RowBox[{"pos", "+", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ep1", "=", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"4", "-", 
             RowBox[{"phasespacepointsperm", "[", 
              RowBox[{"[", 
               RowBox[{"pos", ",", "1"}], "]"}], "]"}]}], ")"}], "/", "2"}], 
          ",", 
          RowBox[{"Modulus", "->", "$P"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ep2", "=", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"4", "-", 
             RowBox[{"phasespacepointsperm", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"pos", "+", "1"}], ",", "1"}], "]"}], "]"}]}], ")"}], 
           "/", "2"}], ",", 
          RowBox[{"Modulus", "->", "$P"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"M1Mat", "=", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{"x", "|->", 
           RowBox[{"Expand", "[", 
            RowBox[{"x", ",", 
             RowBox[{"Modulus", "->", "$P"}]}], "]"}]}], "]"}], "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Mat1", "-", "Mat2"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"ep1", "-", "ep2"}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"M0Mat", "=", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{"x", "|->", 
           RowBox[{"Expand", "[", 
            RowBox[{"x", ",", 

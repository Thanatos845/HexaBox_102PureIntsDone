Cell[BoxData[{
 RowBox[{
  RowBox[{"loopMomentumScalarProductsT", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"loopMomentumScalarProducts", "/.", "tPoint"}], ",", 
     RowBox[{"Modulus", "->", "$P"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mandelstamScalarProductsT", "=", 
   RowBox[{"Expand", "[", 

20176c585312"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"diffIntsIBREDUCED", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"diffInts", "/.", "reductionRules"}], "/.", "ExtraRelations"}], 
     ",", 
     RowBox[{"Modulus", "->", "$P"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NonReduced", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Cases", "[", 
      RowBox[{"diffIntsIBREDUCED", ",", "_hxb", ",", "Infinity"}], "]"}], "//",
      "DeleteDuplicates"}], "//", 
    RowBox[{"EchoFunction", "[", "Length", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NullInts2", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{"NonReduced", ",", "SubLaporta"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diffIntsIBREDUCED", "=", 
   RowBox[{"diffIntsIBREDUCED", "/.", 
    RowBox[{"Thread", "[", 
     RowBox[{"Rule", "[", 
      RowBox[{"NullInts2", ",", "0"}], "]"}], "]"}]}]}], ";"}]}], "Input",

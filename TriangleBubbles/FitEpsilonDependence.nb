Cell[BoxData[
 RowBox[{
  RowBox[{"powerReconstruct", "[", 
   RowBox[{"pars_", ",", "FitVecIn_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pars2", ",", "AnsatzPowersNumi", ",", "FitVec", ",", "AnsatzPowersDeno",

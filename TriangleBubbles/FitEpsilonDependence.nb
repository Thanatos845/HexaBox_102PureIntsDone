      "Solset", ",", "FinalMat", ",", "sol3", ",", "Ansatz", ",", 
      "MaxPower"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"MaxPower", "=", "9"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AnsatzPowersNumi", "=", 
      RowBox[{"FrobeniusSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", "MaxPower"}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"AnsatzPowersDeno", "=", 

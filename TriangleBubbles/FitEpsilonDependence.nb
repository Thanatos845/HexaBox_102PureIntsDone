     "\n", "\t", 
     RowBox[{"sol3", "=", 
      RowBox[{"NullSpace", "[", 
       RowBox[{"FinalMat", ",", 
        RowBox[{"Modulus", "->", "$P"}]}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"Ansatz", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fac", "[", "n", "]"}], 

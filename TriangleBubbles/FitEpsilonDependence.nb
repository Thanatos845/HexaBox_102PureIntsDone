       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", "MaxPower"}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"pars2", "=", 
      RowBox[{"pars", "/.", 
       RowBox[{"{", 

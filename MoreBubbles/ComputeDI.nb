           RowBox[{"241", "*", "10"}]}], "}"}]}], "]"}], ",", "\"\<  \>\"", 
       ",", "var", ",", "\"\</10 \>\"", ",", "intpos", ",", "\"\</241\>\""}], 
      "}"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]"}], "Input",

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "75"}], ",", 
   RowBox[{"i", "<=", "241"}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", "i"}], ";", "\[IndentingNewLine]", 
    RowBox[{"PureIntegralsNew", "[", 
     RowBox[{"[", "pos", "]"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"INTS", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Cases", "[", 
              RowBox[{
               RowBox[{"PureIntegralsNew", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], ",", "_hxb", ",", 
               "Infinity"}], "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{"n_Integer", ":>", 
               RowBox[{"0", "/;", 
                RowBox[{"n", "<", "0"}]}]}], "}"}]}], "//", 
            "DeleteDuplicates"}], ")"}], "/.", 
          RowBox[{"{", 
           RowBox[{"hxb", "->", "List"}], "}"}]}], ",", 
         RowBox[{"{", "1", "}"}]}], "]"}], "/.", 
       RowBox[{"n_Integer", ":>", 
        RowBox[{"1", "/;", 
         RowBox[{"n", ">", "0"}]}]}]}], "/.", 
      RowBox[{"List", "->", "hxb"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"IntList", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"IntList", ",", 
       RowBox[{"{", "INTS", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"sectorString", "=", 
     RowBox[{"StringForm", "[", 
      RowBox[{"\"\<``\>\"", ",", 
       RowBox[{"ToString", "[", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"INTS", "/.", 
               RowBox[{"hxb", "->", "List"}]}], ")"}], "[", 
             RowBox[{"[", "q", "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"q", ",", "1", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"INTS", "/.", 
               RowBox[{"hxb", "->", "List"}]}], "]"}]}], "}"}]}], "]"}], 
         "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"TxtList", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"TxtList", ",", 
       RowBox[{"{", "sectorString", "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"diagram", "=", 
     RowBox[{"plotDiagram", "[", " ", "INTS", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"ToString", "[", 
       RowBox[{"StringForm", "[", 
        RowBox[{
        "\"\</home/dschiebe/Documents/Diagrams/``.pdf\>\"", ",", "pos"}], 
